# Copy to futures/live_bot/.env and adjust. Every value here is a safe default: dry_run makes no
# network calls. Never commit a real .env (it is ignored by git).

# --- mode and strategy -------------------------------------------------------------
BOT_MODE=dry_run                 # dry_run | practice | live
# BOT_CONFIRM_LIVE=I_UNDERSTAND_THIS_IS_REAL_MONEY   # required only for live
BOT_STRATEGY=noop                # noop | random_entry_atr_trail | support_resistance_bounce | vwap_zscore | manual | ote_fvg | disciplined_bracket | combined
BOT_INSTRUMENT=MNQ
BOT_TIMEFRAMES=1min,5min
BOT_INITIAL_DAYS=5
BOT_DYNAMIC_SIZING=0
BOT_TOD_FILTER=0
BOT_DB_PATH=./trading_bot.db

# --- broker (only for your own BrokerClient adapter; leave empty in dry_run) ---------
BROKERAPI_USERNAME=
BROKERAPI_API_KEY=
BROKERAPI_ACCOUNT_NAME=

# --- risk limits (examples; set your own) --------------------------------------------
ACCOUNT_STARTING_BALANCE=250000
ACCOUNT_STARTING_HWM=250000
DAILY_LOSS_LIMIT=5000
TRAILING_DD_AMOUNT=10000
MAX_SINGLE_TRADE_RISK=700
CONSECUTIVE_LOSS_LIMIT=2
# SELF_IMPOSED_DAILY_STOP=3000
# MAX_DAILY_PROFIT=1650
# PROFIT_TARGET_BALANCE=265000
# RISK_STATE_FILE=./state/risk_state.json

# --- bracket / combined strategies --------------------------------------------------
BRACKET_RISK_PER_TRADE=300
BRACKET_CAP_WIN_DOLLARS=1650
BRACKET_MAX_CONTRACTS=50
BRACKET_POC_FILTER=off
BRACKET_DISABLE_VA=0
# BRACKET_DAILY_SEED=./data/daily_rth_seed.csv
# BRACKET_DAILY_HISTORY=./state/daily_history.csv
COMBINED_HISTORY_SOURCE=cache
# COMBINED_SESSION_SEED=./data/session_seed.csv
# COMBINED_SESSION_HISTORY=./state/session_history.csv

# --- optional alerts and local vault ---------------------------------------------------
# ALERT_EMAIL_TO=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# VAULT_DB_PATH=
# VAULT_ENCRYPTION_KEY=
