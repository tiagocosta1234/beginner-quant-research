//@version=5
indicator("High-Win-Rate STDV PO3 Optimized", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// --- Inputs ---
lookbackPeriod = input.int(20, "Lookback Period (Bars)", minval=5)
volMultiplier  = input.float(1.5, "Volume Confirmation Multiplier", minval=1.0)
boxWidth       = input.int(15, "Projection Box Width (Bars)")

// --- Risk / Position Size ---
riskAmount = input.float(3000, "Risk Amount ($)", minval=1)
pointValue = input.float(5.0, "Point Value per Micro ($)", minval=0.1, tooltip="MES=5 | MNQ=2 | MYM/M2K=0.5 | MGC=1")

// --- Trading Window (UTC+1) ---
session = "1200-1700"
inSession = not na(time(timeframe.period, session, "UTC+1"))

// Cut-off: no new trades after 15:45
timeOk = hour(time, "UTC+1") * 100 + minute(time, "UTC+1") < 1545

// --- Higher Timeframe Trend (1H) ---
htfClose = request.security(syminfo.tickerid, "60", close)
htfEMA   = request.security(syminfo.tickerid, "60", ta.ema(close, 50))
htfBull  = htfClose > htfEMA
htfBear  = htfClose < htfEMA

// --- Volatility Filter ---
atr     = ta.atr(14)
avgATR  = ta.sma(atr, 50)
goodVol = atr > avgATR * 0.85 and atr < avgATR * 2.2   // avoid dead & extreme chaos

// --- Indicators ---
avgVol = ta.sma(volume, 20)
rsi    = ta.rsi(close, 14)

volumeConfirmed = volume > (avgVol * volMultiplier)
momentumUp      = rsi > 55 and rsi < 68
momentumDown    = rsi < 45 and rsi > 32

// Strong candle filter
strongBull = close > open and (close - open) > (high - low) * 0.50
strongBear = close < open and (open - close) > (high - low) * 0.50

// --- Rolling Range ---
rollingHigh = ta.highest(high[1], lookbackPeriod)
rollingLow  = ta.lowest(low[1], lookbackPeriod)
swingSize   = rollingHigh - rollingLow

longTP  = rollingHigh + swingSize
shortTP = rollingLow  - swingSize

// --- Daily Controls ---
var int dailyLosses = 0
var int tradesToday = 0
var int lastDay     = 0

currentDay = year(time) * 10000 + month(time) * 100 + dayofmonth(time)

if currentDay != lastDay
    dailyLosses := 0
    tradesToday := 0
    lastDay     := currentDay

canTrade = dailyLosses < 3 and tradesToday < 1     // only FIRST trade of the day

// --- Entry Logic ---
var int lastTradeBar = 0
cooldown = 12

buySignal  = ta.crossover(close, rollingHigh) 
             and volumeConfirmed 
             and momentumUp 
             and strongBull 
             and htfBull 
             and goodVol 
             and timeOk 
             and inSession 
             and canTrade 
             and (bar_index - lastTradeBar > cooldown) 
             and barstate.isconfirmed

sellSignal = ta.crossunder(close, rollingLow) 
             and volumeConfirmed 
             and momentumDown 
             and strongBear 
             and htfBear 
             and goodVol 
             and timeOk 
             and inSession 
             and canTrade 
             and (bar_index - lastTradeBar > cooldown) 
             and barstate.isconfirmed

if buySignal or sellSignal
    lastTradeBar := bar_index
    tradesToday  := tradesToday + 1

// --- Trade Tracking ---
var int   totalTrades  = 0
var int   totalWins    = 0
var float peakR        = 0.0
var float troughR      = 0.0
var float maxDrawdownR = 0.0
var float cumulativeR  = 0.0

var bool  inTrade    = false
var bool  isLong     = false
var float tradeEntry = na
var float tradeSL    = na
var float tradeTP    = na
var int   entryBar   = na

if (buySignal or sellSignal) and not inTrade
    inTrade    := true
    isLong     := buySignal
    tradeEntry := isLong ? rollingHigh : rollingLow
    tradeSL    := isLong ? rollingLow  : rollingHigh
    tradeTP    := isLong ? longTP      : shortTP
    entryBar   := bar_index
    totalTrades := totalTrades + 1

// Force close at 20:50 UTC+1
forceCloseTime = hour(time, "UTC+1") * 100 + minute(time, "UTC+1") >= 2050

if inTrade and barstate.isconfirmed
    tpHit = isLong ? high >= tradeTP : low  <= tradeTP
    slHit = isLong ? low  <= tradeSL : high >= tradeSL
    forceClose = forceCloseTime

    if tpHit or slHit or forceClose
        float result = 0.0
        float exitPrice = na

        if tpHit
            result := 1.0
            exitPrice := tradeTP
            totalWins := totalWins + 1
        else if slHit
            result := -1.0
            exitPrice := tradeSL
            dailyLosses := dailyLosses + 1
        else
            // Force close at market – real R
            riskPoints = math.abs(tradeEntry - tradeSL)
            if riskPoints > 0
                rawMove = isLong ? (close - tradeEntry) : (tradeEntry - close)
                result := rawMove / riskPoints
            exitPrice := close
            if result < 0
                dailyLosses := dailyLosses + 1

        cumulativeR := cumulativeR + result

        if cumulativeR > peakR
            peakR   := cumulativeR
            troughR := cumulativeR
        else if cumulativeR < troughR
            troughR := cumulativeR
            currentDD = peakR - troughR
            if currentDD > maxDrawdownR
                maxDrawdownR := currentDD

        line.new(entryBar, tradeEntry, bar_index, exitPrice, color=color.white, style=line.style_dashed, width=1)
        inTrade := false

// --- Dashboard ---
var table dashboard = table.new(position.top_right, 2, 6,
     bgcolor=color.new(color.black, 20),
     border_color=color.new(color.gray, 40),
     border_width=1,
     frame_color=color.new(color.gray, 20),
     frame_width=1)

winRate    = totalTrades > 0 ? (totalWins / totalTrades) * 100 : 0.0
winRateStr = totalTrades > 0 ? str.tostring(winRate, "#.#") + "%" : "—"

finalPnL   = cumulativeR * riskAmount
maxDD      = maxDrawdownR * riskAmount

finalStr   = (finalPnL >= 0 ? "+" : "-") + "$" + str.tostring(math.abs(finalPnL), "#")
ddStr      = maxDD > 0 ? str.tostring(maxDD, "#") : "—"

winColor   = winRate >= 50 ? color.new(color.green, 20) : color.new(color.red, 20)
pnlColor   = finalPnL >= 0 ? color.new(color.green, 20) : color.new(color.red, 20)

if barstate.islast
    table.cell(dashboard, 0, 0, "STDV PO3 Optimized", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 10), text_halign=text.align_center)
    table.cell(dashboard, 1, 0, "", text_color=color.white, text_size=size.small, bgcolor=color.new(color.navy, 10))
    table.cell(dashboard, 0, 1, "Total Trades", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 1, str.tostring(totalTrades), text_color=color.white, text_size=size.small)
    table.cell(dashboard, 0, 2, "Wins", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 2, str.tostring(totalWins), text_color=color.white, text_size=size.small)
    table.cell(dashboard, 0, 3, "Win Rate", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 3, winRateStr, text_color=color.white, text_size=size.small, bgcolor=winColor)
    table.cell(dashboard, 0, 4, "Max DD", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 4, ddStr, text_color=color.white, text_size=size.small, bgcolor=color.new(color.red, 20))
    table.cell(dashboard, 0, 5, "Final P&L ($)", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 5, finalStr, text_color=color.white, text_size=size.small, bgcolor=pnlColor)

// --- Visuals ---
if buySignal
    alert("LONG | " + syminfo.ticker + " | TP: " + str.tostring(longTP, "#.##"), alert.freq_once_per_bar)
    box.new(bar_index, longTP, bar_index + boxWidth, rollingHigh, bgcolor=color.new(color.green, 85), border_color=color.green)
    box.new(bar_index, rollingHigh, bar_index + boxWidth, rollingLow, bgcolor=color.new(color.red, 85), border_color=color.red)
    
    contracts = swingSize > 0 ? riskAmount / (swingSize * pointValue) : 0.0
    label.new(bar_index, longTP, str.tostring(contracts, "#.##"), style=label.style_label_down, color=color.new(color.black, 20), textcolor=color.white, size=size.normal)

if sellSignal
    alert("SHORT | " + syminfo.ticker + " | TP: " + str.tostring(shortTP, "#.##"), alert.freq_once_per_bar)
    box.new(bar_index, shortTP, bar_index + boxWidth, rollingLow, bgcolor=color.new(color.green, 85), border_color=color.green)
    box.new(bar_index, rollingLow, bar_index + boxWidth, rollingHigh, bgcolor=color.new(color.red, 85), border_color=color.red)
    
    contracts = swingSize > 0 ? riskAmount / (swingSize * pointValue) : 0.0
    label.new(bar_index, shortTP, str.tostring(contracts, "#.##"), style=label.style_label_up, color=color.new(color.black, 20), textcolor=color.white, size=size.normal)

plotshape(buySignal,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)

bgcolor(inSession and timeOk ? color.new(color.blue, 93) : na, title="12:00-15:45 Window")