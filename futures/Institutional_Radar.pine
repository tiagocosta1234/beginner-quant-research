//@version=6
indicator("BrokerAPI Institutional Radar", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ==============================================================================
// 1. INPUT PARAMETERS & ACCOUNT GEARING (BROKER RISK PROTOCOLS)
// ==============================================================================
var string G_MODE = "Account Gear & Risk Protocol"
op_mode = input.string("Broker 250k Sprint ($2,500)", "Operating Mode", 
     options=[
         "Broker 250k Shield ($1,000)",
         "Broker 250k Standard ($1,250)",
         "Broker 250k Moderate ($1,500)",
         "Broker 250k Sprint ($2,500)",
         "Evaluation Sprint ($1,100)", 
         "The Shield ($500)", 
         "Standard ($300)", 
         "BROKER ($150)", 
         "Custom Dollar Risk"
     ], group=G_MODE,
     tooltip="Broker 250k Shield: $1,000 risk (2 NQ / 20 MNQ) - 10% MLL, 20% DLL, maximum survival\nBroker 250k Standard: $1,250 risk (2 NQ / 25 MNQ) - 12.5% MLL, 25% DLL\nBroker 250k Moderate: $1,500 risk (3 NQ / 30 MNQ) - 15% MLL, 30% DLL\nBroker 250k Sprint: $2,500 risk (5 NQ / 50 MNQ) - 25% MLL, 50% DLL\nSprint: $1,100 risk per trade\nShield: $500 risk per trade with 1-Loss Daily Lockout\nCustom: User-defined dollar risk")

custom_risk_dlr = input.float(500.0, "Custom Risk ($) [if Custom selected]", minval=10.0, step=25.0, group=G_MODE)

// Resolve Dynamic Dollar Risk Budget
float target_risk_dlr_in = op_mode == "Broker 250k Sprint ($2,500)" ? 2500.0 :
     (op_mode == "Broker 250k Moderate ($1,500)" ? 1500.0 :
     (op_mode == "Broker 250k Standard ($1,250)" ? 1250.0 :
     (op_mode == "Broker 250k Shield ($1,000)" ? 1000.0 :
     (op_mode == "Evaluation Sprint ($1,100)" ? 1100.0 :
     (op_mode == "The Shield ($500)" ? 500.0 :
     (op_mode == "Standard ($300)" ? 300.0 :
     (op_mode == "BROKER ($150)" ? 150.0 :
     custom_risk_dlr)))))))

var string G_GEOM = "Trade Geometry (Institutional Multi-Target R:R)"
stop_pts_in   = input.float(25.0, "Stop Loss Points (NQ / Master SL)", minval=1.0, step=1.0, group=G_GEOM, tooltip="25 points provides the optimal room for secondary retest wicks on NQ (1:1 R:R base)")
target_pts_in = input.float(37.5, "Take Profit Points (1:1.5 Primary Target - Max Profit)", minval=1.0, step=0.5, group=G_GEOM, tooltip="37.5 points gives a 1:1.5 R:R which mathematically maximizes raw net profit.")
box_bars   = input.int(20, "Projection Box Width (Bars)", minval=5, maxval=50, group=G_GEOM)

var string G_TIME = "Session Windows (America/New_York)"
tz = "America/New_York"
london_session_input = input.string("0200-0800:23456", "London Range Window", group=G_TIME)
ny_entry_input       = input.string("0942-1045:23456", "NY Institutional Entry Window", group=G_TIME, tooltip="Starts strictly at 09:42 to bypass the 09:30-09:41 opening whip")
flatten_hr           = input.int(15, "Hard Flatten Hour (EST)", minval=0, maxval=23, group=G_TIME)
flatten_min          = input.int(45, "Hard Flatten Minute (EST)", minval=0, maxval=59, group=G_TIME)

var string G_FILTERS = "Execution Rules & Risk Gates"
in_min_sweep_pts    = input.float(1.0, "Minimum Sweep Depth (Points)", group=G_FILTERS)

bool is_gc = str.contains(syminfo.ticker, "GC") or str.contains(syminfo.ticker, "MGC")
bool is_nq = str.contains(syminfo.ticker, "NQ") or str.contains(syminfo.ticker, "MNQ")

float stop_pts      = is_gc ? 25.0 : (is_nq ? 40.0 : stop_pts_in)
float target_pts    = is_gc ? 40.0 : (is_nq ? 40.0 : target_pts_in)
float min_sweep_pts = is_gc ? 1.0  : (is_nq ? 10.0 : in_min_sweep_pts)
float target_risk_dlr = is_gc ? 2500.0 : (is_nq ? 3500.0 : target_risk_dlr_in)
// ---------------------------------------------------
max_sweep_pts       = input.float(25.0, "Maximum Sweep Depth (Points)", group=G_FILTERS)
use_vwap_gate       = input.bool(true, "Enforce Session VWAP Polarity", group=G_FILTERS)
use_loss_pause      = input.bool(true, "Enforce 1-Loss Daily Lockout (Shield)", group=G_FILTERS)
enforce_5m_gate     = input.bool(true, "Enforce 5m Optimal Timeframe Gate", group=G_FILTERS, tooltip="Blocks signals if chart is not on the institutional 5m timeframe")

var string G_VISUALS = "Visual & Display Settings"
show_sessions       = input.bool(true, "Show Session Background Shading", group=G_VISUALS)
show_sweep_lines    = input.bool(true, "Show Swept Level Reference Rays", group=G_VISUALS)
show_entry_labels   = input.bool(true, "Show Detailed Entry Target Labels", group=G_VISUALS)

var string G_TABLE = "Fleet Sizing Dashboard"
show_sizing_tbl     = input.bool(true, "Display Dynamic Sizing Dashboard", group=G_TABLE)
sizing_tbl_pos_str  = input.string("Top Right", "Dashboard Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=G_TABLE)
es_sl_pts           = input.float(6.25, "ES / MES Stop Loss Points", minval=0.25, step=0.25, group=G_TABLE)
gc_sl_pts           = input.float(2.50, "GC / MGC Stop Loss Points", minval=0.25, step=0.10, group=G_TABLE)
ym_sl_pts           = input.float(50.0, "YM / MYM Stop Loss Points", minval=1.0, step=1.0, group=G_TABLE)

var string G_HUD = "Performance Cockpit HUD"
show_cockpit_hud    = input.bool(true, "Display Performance Cockpit HUD", group=G_HUD)
hud_pos_str         = input.string("Bottom Right", "Performance Cockpit Position", options=["Top Right", "Bottom Right", "Top Left", "Bottom Left"], group=G_HUD)

// Dynamic Position Sizing for Active Chart Instrument
// Strict floor clamping guarantees dollar risk never exceeds budget
// Clamped strictly to Broker 250k limits: max 25 Minis / 250 Micros
float pt_val = syminfo.pointvalue
int raw_active_cts = (stop_pts * pt_val > 0) ? math.floor(target_risk_dlr / (stop_pts * pt_val)) : 0
bool is_micro_chart = str.contains(syminfo.ticker, "MNQ") or str.contains(syminfo.ticker, "MES") or str.contains(syminfo.ticker, "MGC") or str.contains(syminfo.ticker, "MYM")
int max_allowed_cts = is_micro_chart ? 250 : 25
int clamped_active  = math.min(max_allowed_cts, raw_active_cts)
int contracts = clamped_active >= 1 ? clamped_active : (is_micro_chart ? 1 : 0)
float trade_risk_dlr      = stop_pts * pt_val * contracts
float trade_tp1_0_pts     = stop_pts * 1.0
float trade_tp1_5_pts     = stop_pts * 1.5
float trade_tp2_0_pts     = stop_pts * 2.0
float trade_tp1_0_dlr     = trade_tp1_0_pts * pt_val * contracts
float trade_tp1_5_dlr     = trade_tp1_5_pts * pt_val * contracts
float trade_target_dlr    = target_pts * pt_val * contracts
float comm_per_trade      = 0.62 * 2.0 * contracts

// ==============================================================================
// 2. SESSION TIME CALCULATIONS & LONDON RANGE EXTRACTION
// ==============================================================================
// Optimal Timeframe Detection (5-Minute Chart Mandate)
is_5m = timeframe.isminutes and timeframe.multiplier == 5

in_london  = not na(time(timeframe.period, london_session_input, tz))
in_ny_open = not na(time(timeframe.period, ny_entry_input, tz))
int bar_open_mins  = hour(time, tz) * 60 + minute(time, tz)
int bar_close_mins = hour(time_close(timeframe.period), tz) * 60 + minute(time_close(timeframe.period), tz)
if bar_close_mins == 0
    bar_close_mins := 1440
int flatten_mins   = flatten_hr * 60 + flatten_min
in_flatten = (bar_open_mins <= flatten_mins) and (bar_close_mins > flatten_mins)
is_new_day = ta.change(time("D", tz)) != 0

var float lon_high = na
var float lon_low  = na

if is_new_day
    lon_high := na
    lon_low  := na

if in_london
    lon_high := na(lon_high) ? high : math.max(lon_high, high)
    lon_low  := na(lon_low)  ? low  : math.min(lon_low, low)

// Session Backgrounds & Strict Visual Block (Red-Out Outside 09:42-10:45 EST)
// bg removed : na, title="Locked Out Background (Outside 09:42-10:45 EST)")
// bg removed : na, title="NY Institutional Window Background (Active 09:42-10:45 EST)")
bgcolor(in_flatten ? color.new(color.maroon, 70) : na, title="Hard Flatten Window (15:55 EST)")

// Plot Continuous London Boundaries
plot(lon_high, "London High (02:00-08:00)", color=color.new(color.fuchsia, 30), linewidth=2, style=plot.style_line)
plot(lon_low,  "London Low (02:00-08:00)",  color=color.new(color.aqua, 30), linewidth=2, style=plot.style_line)

// ==============================================================================
// 3. SESSION VWAP POLARITY
// ==============================================================================
var float sum_vol_vwap = 0.0
var float sum_pv_vwap  = 0.0
in_rth = not na(time(timeframe.period, "0930-1600:23456", tz))

if is_new_day or (not in_rth[1] and in_rth)
    sum_vol_vwap := 0.0
    sum_pv_vwap  := 0.0

if in_rth
    sum_vol_vwap += volume
    sum_pv_vwap  += ((high + low + close) / 3.0) * volume

session_vwap = sum_vol_vwap > 0 ? sum_pv_vwap / sum_vol_vwap : na
plot(session_vwap, "Session VWAP", color=color.new(color.yellow, 20), linewidth=2)

bool vwap_bullish = not use_vwap_gate or (not na(session_vwap) and close >= session_vwap)
bool vwap_bearish = not use_vwap_gate or (not na(session_vwap) and close <= session_vwap)

// ==============================================================================
// 5. TRADE TRACKING & PNL STATE MACHINE
// ==============================================================================
var int   total_trades = 0
var int   win_trades   = 0
var int   loss_trades  = 0
var int   cur_loss_streak = 0
var int   max_loss_streak = 0

var int daily_trades = 0
var bool daily_loss_locked = false

if is_new_day
    daily_trades := 0
    daily_loss_locked := false

bool can_trade_today = not daily_loss_locked // Removed 1-trade limit

// London Sweep Conditions (09:42 - 10:45 EST)
float cur_sweep_h = high - lon_high
bool is_valid_grade_h = not is_gc or (cur_sweep_h >= 3.0 and cur_sweep_h <= 6.0) or (cur_sweep_h > 10.0)
bool is_valid_time = not is_gc or (hour(time, tz) == 9) or (hour(time, tz) == 10 and minute(time, tz) < 30)
bool sweep_high = in_ny_open and not na(lon_high) and (high > lon_high) and (close < lon_high) and (cur_sweep_h >= min_sweep_pts) and (cur_sweep_h <= max_sweep_pts) and vwap_bearish and can_trade_today and is_valid_grade_h and is_valid_time 
float cur_sweep_l = lon_low - low
bool is_valid_grade_l = not is_gc or (cur_sweep_l >= 3.0 and cur_sweep_l <= 6.0) or (cur_sweep_l > 10.0)
bool sweep_low  = in_ny_open and not na(lon_low)  and (low < lon_low)   and (close > lon_low)  and (cur_sweep_l >= min_sweep_pts)   and (cur_sweep_l <= max_sweep_pts)   and vwap_bullish and can_trade_today and is_valid_grade_l and is_valid_time 

// Confirmed Trigger Bar Color Highlights
barcolor(sweep_low ? color.new(#00E676, 0) : (sweep_high ? color.new(#FF1744, 0) : na), title="Trigger Bar Highlight")





// Cumulative PnL & Peak-to-Trough Drawdown Tracking
var float cum_net_pnl  = 0.0
var float peak_pnl     = 0.0
var float max_drawdown = 0.0


// Historical Equity Trajectory Array for Mini Sparkline Curve
var float[] equity_curve = array.new_float(0)

// Active Position Tracking for Trade Resolution
var int   active_dir   = 0 // 0 Flat, 1 Long, -1 Short
var float active_entry = 0.0
var int   active_entry_bar = 0
var float active_sl    = 0.0
var float active_tp    = 0.0

// Position Management
if active_dir == 1 // LONG
    bool hit_sl = low <= active_sl
    bool hit_tp = high >= active_tp
    if hit_sl or hit_tp or in_flatten
        float out_pnl = 0.0
        if hit_sl
            out_pnl := -trade_risk_dlr - comm_per_trade
            loss_trades += 1
            cur_loss_streak += 1
            if cur_loss_streak > max_loss_streak
                max_loss_streak := cur_loss_streak
            label.new(bar_index, high, "L (-$" + str.tostring(math.abs(out_pnl), "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.normal)
            if use_loss_pause
                daily_loss_locked := true
        else if hit_tp
            out_pnl := trade_target_dlr - comm_per_trade
            win_trades += 1
            cur_loss_streak := 0
            label.new(bar_index, low, "W (+$" + str.tostring(out_pnl, "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)
        else if in_flatten
            float pts_diff = (close - active_entry) * pt_val * contracts
            out_pnl := pts_diff - comm_per_trade
            if out_pnl > 0
                win_trades += 1
                label.new(bar_index, low, "W (+$" + str.tostring(out_pnl, "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)
            else
                loss_trades += 1
                label.new(bar_index, high, "L (-$" + str.tostring(math.abs(out_pnl), "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.normal)
                if use_loss_pause
                    daily_loss_locked := true

        cum_net_pnl += out_pnl
        total_trades += 1
        active_dir := 0
        array.push(equity_curve, cum_net_pnl)
        if cum_net_pnl > peak_pnl
            peak_pnl := cum_net_pnl
        float cur_dd = peak_pnl - cum_net_pnl
        if cur_dd > max_drawdown
            max_drawdown := cur_dd

else if active_dir == -1 // SHORT
    bool hit_sl = high >= active_sl
    bool hit_tp = low <= active_tp
    if hit_sl or hit_tp or in_flatten
        float out_pnl = 0.0
        if hit_sl
            out_pnl := -trade_risk_dlr - comm_per_trade
            loss_trades += 1
            cur_loss_streak += 1
            if cur_loss_streak > max_loss_streak
                max_loss_streak := cur_loss_streak
            label.new(bar_index, high, "L (-$" + str.tostring(math.abs(out_pnl), "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.normal)
            if use_loss_pause
                daily_loss_locked := true
        else if hit_tp
            out_pnl := trade_target_dlr - comm_per_trade
            win_trades += 1
            cur_loss_streak := 0
            label.new(bar_index, low, "W (+$" + str.tostring(out_pnl, "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)
        else if in_flatten
            float pts_diff = (active_entry - close) * pt_val * contracts
            out_pnl := pts_diff - comm_per_trade
            if out_pnl > 0
                win_trades += 1
                label.new(bar_index, low, "W (+$" + str.tostring(out_pnl, "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.green, textcolor=color.white, style=label.style_label_up, size=size.normal)
            else
                loss_trades += 1
                label.new(bar_index, high, "L (-$" + str.tostring(math.abs(out_pnl), "#") + " | " + str.tostring(contracts) + " " + syminfo.ticker + ")", color=color.red, textcolor=color.white, style=label.style_label_down, size=size.normal)
                if use_loss_pause
                    daily_loss_locked := true

        cum_net_pnl += out_pnl
        total_trades += 1
        active_dir := 0
        array.push(equity_curve, cum_net_pnl)
        if cum_net_pnl > peak_pnl
            peak_pnl := cum_net_pnl
        float cur_dd = peak_pnl - cum_net_pnl
        if cur_dd > max_drawdown
            max_drawdown := cur_dd

// Trigger Trade Entry
bool can_enter = (active_dir == 0) and not in_flatten and can_trade_today and (contracts > 0) 

if can_enter and (sweep_high or sweep_low)
    daily_trades += 1
    if sweep_low
        active_dir   := 1
        active_entry := close
        active_entry_bar := bar_index
        active_sl    := close - stop_pts
        active_tp    := close + target_pts
    else if sweep_high
        active_dir   := -1
        active_entry := close
        active_entry_bar := bar_index
        active_sl    := close + stop_pts
        active_tp    := close - target_pts

// ==============================================================================
// 5. ENHANCED VISUAL ENTRIES, SWEPT LEVEL RAYS & MULTI-TARGET PROJECTION BOXES
// ==============================================================================
if can_enter and sweep_low
    float entry_p  = close // Anchored precisely to candle close for live market execution
    float sl_p     = entry_p - stop_pts
    float tp2_p    = entry_p + target_pts
    int right_b    = bar_index + box_bars
    float rr_ratio = stop_pts > 0 ? target_pts / stop_pts : 1.0

    // 1. Swept London Low Reference Ray
    if show_sweep_lines
        line.new(bar_index - 5, entry_p, right_b, entry_p, color=color.new(color.aqua, 20), width=2, style=line.style_dashed)

    // 2. Multi-Target R:R Projection Boxes
    box.new(bar_index, tp2_p, right_b, entry_p, bgcolor=color.new(color.green, 82), border_color=color.new(color.green, 30), border_width=1)
    box.new(bar_index, entry_p, right_b, sl_p, bgcolor=color.new(color.red, 82), border_color=color.new(color.red, 30), border_width=1)
    line.new(bar_index, entry_p, right_b, entry_p, color=color.new(color.white, 30), width=1, style=line.style_solid)

    // Boundary Projection Labels
    string tp_lbl_str = "TP (1:" + str.tostring(rr_ratio, "#.#") + "): +" + str.tostring(target_pts, "#") + "pts (+$" + str.tostring(trade_target_dlr, "#") + ")"
    label.new(right_b, tp2_p, tp_lbl_str, color=color.green, textcolor=color.white, style=label.style_label_left, size=size.small)

    // Detailed Institutional Signal Label at Entry Bar
    float sweep_depth_val_h = high - lon_high
    string prob_str_val_h = "Grade: "
    if sweep_depth_val_h >= 3.0 and sweep_depth_val_h <= 6.0
        prob_str_val_h += "A (Prime 3-6pt Sweep)"
    else if sweep_depth_val_h > 6.0 and sweep_depth_val_h <= 10.0
        prob_str_val_h += "D (Deep Sweep)"
    else if sweep_depth_val_h > 10.0
        prob_str_val_h += "B (Extreme Sweep)"
    else
        prob_str_val_h += "C (Shallow Sweep)"
    if hour(time, tz) == 10 and minute(time, tz) >= 30
        prob_str_val_h := "Grade: F (Time Decay)"
    label.new(bar_index, sl_p, prob_str_val_h, color=color.new(color.orange, 0), textcolor=color.black, style=label.style_label_down, size=size.normal)

    // Native Alert Dispatch
    alert("INSTITUTIONAL SHORT SWEEP: " + str.tostring(contracts) + " " + syminfo.ticker + " @ " + str.tostring(entry_p, "#.##") + " | SL: " + str.tostring(sl_p, "#.##") + " | TP: " + str.tostring(tp2_p, "#.##") + " | Mode: " + op_mode, alert.freq_once_per_bar_close)

// TradingView GUI Alert Conditions
alertcondition(sweep_low, title="Long Sweep Entry Alert", message="Institutional Long Sweep Triggered: {{ticker}} @ {{close}}")
alertcondition(sweep_high, title="Short Sweep Entry Alert", message="Institutional Short Sweep Triggered: {{ticker}} @ {{close}}")

// ==============================================================================
// 6. MULTI-TICKER DYNAMIC CONTRACT SIZING DASHBOARD (TABLE)
// ==============================================================================
f_get_table_pos(string pos_str) =>
    pos_str == "Top Right" ? position.top_right :
     (pos_str == "Bottom Right" ? position.bottom_right :
     (pos_str == "Top Left" ? position.top_left : position.bottom_left))

sizing_pos = f_get_table_pos(sizing_tbl_pos_str)
var table sizing_tbl = table.new(sizing_pos, 2, 9, bgcolor=color.new(#0d1117, 10), frame_color=#30363d, frame_width=1, border_color=#21262d, border_width=1)

if barstate.islast and show_sizing_tbl
    table.cell(sizing_tbl, 0, 0, "RISK", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 0, "-$" + str.tostring(trade_risk_dlr, "#"), bgcolor=#21262d, text_color=color.red, text_size=size.small)

    table.cell(sizing_tbl, 0, 1, "SIZE", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 1, str.tostring(contracts) + " " + syminfo.ticker, bgcolor=#21262d, text_color=color.yellow, text_size=size.small)

    float wr = total_trades > 0 ? (win_trades / total_trades) * 100.0 : 0.0
    table.cell(sizing_tbl, 0, 2, "WIN RATE", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 2, str.tostring(wr, "#.1") + "%", bgcolor=#21262d, text_color=color.white, text_size=size.small)

    table.cell(sizing_tbl, 0, 3, "WINS", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 3, str.tostring(win_trades), bgcolor=#21262d, text_color=color.green, text_size=size.small)

    table.cell(sizing_tbl, 0, 4, "LOSSES", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 4, str.tostring(loss_trades), bgcolor=#21262d, text_color=color.red, text_size=size.small)

    color streak_col = max_loss_streak >= 3 ? color.new(#FF1744, 0) : (max_loss_streak == 2 ? color.orange : color.white)
    table.cell(sizing_tbl, 0, 5, "WORST STREAK", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 5, str.tostring(max_loss_streak) + "L in a row", bgcolor=#21262d, text_color=streak_col, text_size=size.small)
    
    color pnl_col = cum_net_pnl > 0 ? color.green : (cum_net_pnl < 0 ? color.red : color.white)
    string pnl_prefix = cum_net_pnl > 0 ? "+$" : (cum_net_pnl < 0 ? "-$" : "$")
    table.cell(sizing_tbl, 0, 6, "NET PROFIT", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 6, pnl_prefix + str.tostring(math.abs(cum_net_pnl), "#"), bgcolor=#21262d, text_color=pnl_col, text_size=size.small)

    float total_rr = trade_risk_dlr > 0 ? cum_net_pnl / trade_risk_dlr : 0.0
    table.cell(sizing_tbl, 0, 7, "TOTAL R:R", bgcolor=#21262d, text_color=color.new(#00E5FF, 0), text_size=size.small)
    table.cell(sizing_tbl, 1, 7, str.tostring(total_rr, "#.#") + "R", bgcolor=#21262d, text_color=pnl_col, text_size=size.small)

    table.cell(sizing_tbl, 0, 8, "HOLIDAY RULE", bgcolor=#21262d, text_color=color.new(#FF5252, 0), text_size=size.tiny)
    table.cell(sizing_tbl, 1, 8, "Auto-Liq 15m before early close", bgcolor=#21262d, text_color=color.white, text_size=size.tiny)
