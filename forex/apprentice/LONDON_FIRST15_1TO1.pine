//@version=6
indicator("London First 15m — 1:1", overlay=true, max_boxes_count=500, max_labels_count=500)

// Trades the FIRST 15-minute candle of the London open (08:00-08:15 London time, DST-aware): ONE trade EVERY trading day.
// Entry = candle close. Stop = other end of the candle + buffer (never tighter than the risk floor). Target = exactly 1R.
// Flat at the session end. Chart timeframe must be 1, 3, 5 or 15 min.
// Direction is selectable. Defaults come from the pre-registered 2019-2023 tests (PREREG_EDGE_LAB_5): NOT validated, no edge found.

// ─── Inputs ───────────────────────────────────────────────────────────────────
dirMode     = input.string("Candle", "Direction rule", options=["Candle", "Daily trend", "Prior day", "Since daily open"])
openHour    = input.int(8,       "London open hour",                         minval=0, maxval=23)
endHour     = input.int(16,      "Flat at the end of session (London hour)", minval=9, maxval=23)
bufRange    = input.float(0.5,   "Stop buffer (× candle range beyond the extreme)", minval=0.0, step=0.1)
floorATR    = input.float(0.03,  "Risk floor (× prior daily ATR)",           minval=0.0, step=0.01)
costAuto    = input.bool(true,   "Auto cost by symbol (round trip: MGC 0.32, MNQ 1.1, MES 0.74, MYM 4.4 pts)")
costPts     = input.float(0.3,   "Cost per trade, round trip (points) when Auto is off or symbol unknown", minval=0.0)
riskUSD     = input.float(100.0, "Risk per trade (USD) for the size row",    minval=1.0)

// 1 tick slippage per side + USD 1.20 commission per micro, in points (same cost model as the Python tests)
costUsed = not costAuto ? costPts : syminfo.root == "MGC" ? 0.32 : syminfo.root == "MNQ" ? 1.1 : syminfo.root == "MES" ? 0.74 : syminfo.root == "MYM" ? 4.4 : costPts
pointVal = syminfo.pointvalue
boxMinutes  = input.int(60,      "Projection box length (minutes)",          minval=5)

// ─── Session maths on London clock ───────────────────────────────────────────
tfMin    = timeframe.in_seconds() / 60
okTF     = timeframe.isintraday and timeframe.in_seconds() >= 60 and 900 % timeframe.in_seconds() == 0
tod      = hour(time, "Europe/London") * 60 + minute(time, "Europe/London")
openTod  = openHour * 60
candEnd  = openTod + 15
endTod   = endHour * 60
inWin    = tod >= openTod and tod < candEnd
isLast   = okTF and inWin and tod + tfMin >= candEnd
outSess  = tod < openTod or tod >= endTod

// ─── Opening candle ───────────────────────────────────────────────────────────
var float wOpen  = na
var float wHigh  = na
var float wLow   = na
var box   candBox = na
if inWin and not inWin[1]
    wOpen := open
    wHigh := high
    wLow  := low
    candBox := box.new(bar_index, high, bar_index + 1, low, bgcolor=color.new(color.blue, 87), border_color=color.new(color.blue, 50), border_width=1)
else if inWin
    wHigh := math.max(wHigh, high)
    wLow  := math.min(wLow, low)
    if not na(candBox)
        box.set_right(candBox,  bar_index + 1)
        box.set_top(candBox,    wHigh)
        box.set_bottom(candBox, wLow)

// ─── Daily context (prior-day values only, no repainting) ─────────────────────
[dailyATR, trendUp, prevUp, dailyOpen] = request.security(syminfo.tickerid, "D", [ta.atr(14)[1], close[1] > ta.sma(close, 20)[1], close[1] > open[1], open], lookahead=barmerge.lookahead_on)

// ─── Direction ────────────────────────────────────────────────────────────────
candleUp   = close > wOpen
candleDn   = close < wOpen
dirLong    = dirMode == "Candle" ? (candleUp or (not candleDn and trendUp)) : dirMode == "Daily trend" ? trendUp : dirMode == "Prior day" ? prevUp : wOpen > dailyOpen
agrees     = dirLong == trendUp   // A-grade: the trade agrees with the daily trend (information only, nothing is skipped)

var bool inTrade = false
passes     = isLast and barstate.isconfirmed and not na(dailyATR) and not inTrade
buySignal  = passes and dirLong
sellSignal = passes and not dirLong

var string todayStatus = "waiting"
if inWin and not inWin[1]
    todayStatus := "candle forming"
if not okTF
    todayStatus := "set chart to 1/3/5/15m"
else if buySignal
    todayStatus := "LONG"
else if sellSignal
    todayStatus := "SHORT"

// ─── Trade tracking (real R, stop first, costs included) ──────────────────────
var int   closedTrades = 0
var int   totalWins    = 0
var float peakR        = 0.0
var float maxDrawdownR = 0.0
var float cumulativeR  = 0.0
var bool  isLong     = false
var bool  tradeAgrees = false
var float tradeEntry = na
var float tradeSL    = na
var float tradeTP    = na
var float tradeRisk  = na
var int   tradeSize  = 0
var int   entryBar   = na

if buySignal or sellSignal
    isLong      := buySignal
    tradeAgrees := agrees
    tradeEntry  := close
    extreme     = isLong ? wLow : wHigh
    tradeRisk   := math.max(math.abs(close - extreme) + bufRange * (wHigh - wLow), floorATR * dailyATR)
    tradeSL     := isLong ? tradeEntry - tradeRisk : tradeEntry + tradeRisk
    tradeTP     := isLong ? tradeEntry + tradeRisk : tradeEntry - tradeRisk
    tradeSize   := tradeRisk > 0 ? int(math.floor(riskUSD / (tradeRisk * pointVal))) : 0
    entryBar    := bar_index
    inTrade     := true
    box.new(time, math.max(tradeEntry, tradeTP), time + boxMinutes * 60000, math.min(tradeEntry, tradeTP), xloc=xloc.bar_time, bgcolor=color.new(color.green, 85), border_color=color.green)
    box.new(time, math.max(tradeEntry, tradeSL), time + boxMinutes * 60000, math.min(tradeEntry, tradeSL), xloc=xloc.bar_time, bgcolor=color.new(color.red,   85), border_color=color.red)
    alert((isLong ? "LONG: " : "SHORT: ") + syminfo.ticker + " | Entry: " + str.tostring(tradeEntry, "#.##") + " | SL: " + str.tostring(tradeSL, "#.##") + " | TP (1R): " + str.tostring(tradeTP, "#.##") + " | Size: " + str.tostring(tradeSize), alert.freq_once_per_bar)

if inTrade and barstate.isconfirmed and bar_index > entryBar
    tpHit = isLong ? high >= tradeTP : low  <= tradeTP
    slHit = isLong ? low  <= tradeSL : high >= tradeSL
    if outSess or slHit or tpHit
        exitPrice = outSess ? open : (slHit ? tradeSL : tradeTP)
        gross     = tradeRisk > 0 ? (isLong ? exitPrice - tradeEntry : tradeEntry - exitPrice) / tradeRisk : 0.0
        result    = tradeRisk > 0 ? gross - costUsed / tradeRisk : 0.0
        exitColor = result > 0 ? color.green : color.red
        closedTrades += 1
        if result > 0
            totalWins += 1
        label.new(bar_index, exitPrice, text=(result >= 0 ? "+" : "") + str.tostring(result, "0.00") + "R" + (outSess ? " (session end)" : ""), color=color.new(exitColor, 20), textcolor=color.white, style=result > 0 ? label.style_label_up : label.style_label_down, size=size.small)
        cumulativeR += result
        peakR := math.max(peakR, cumulativeR)
        maxDrawdownR := math.max(maxDrawdownR, peakR - cumulativeR)
        inTrade := false

// ─── Dashboard (same theme as STDV PO3) ───────────────────────────────────────
var table dashboard = table.new(position.top_right, 2, 9, bgcolor=color.new(color.black, 20), border_color=color.new(color.gray, 40), border_width=1, frame_color=color.new(color.gray, 20), frame_width=1)
winRate    = closedTrades > 0 ? (totalWins / closedTrades) * 100 : 0.0
winRateStr = closedTrades > 0 ? str.tostring(winRate, "#.#") + "%" : "—"
ddStr      = maxDrawdownR > 0 ? str.tostring(maxDrawdownR, "#.##") + "R" : "—"
netRStr    = closedTrades > 0 ? str.tostring(cumulativeR, "#.##") + "R" : "—"
sizeStr    = tradeSize > 0 ? str.tostring(tradeSize) + " micro" : "—"
gradeStr   = na(tradeEntry) ? "—" : tradeAgrees ? "A · with daily trend" : "B · against daily trend"
winColor   = winRate >= 50 ? color.new(color.green, 20) : color.new(color.red, 20)
ddColor    = maxDrawdownR <= 3 ? color.new(color.green, 20) : maxDrawdownR <= 6 ? color.new(color.orange, 20) : color.new(color.red, 20)
netRColor  = cumulativeR > 0 ? color.new(color.green, 20) : cumulativeR < 0 ? color.new(color.red, 20) : color.new(color.gray, 20)
todayColor = todayStatus == "LONG" ? color.new(color.green, 20) : todayStatus == "SHORT" ? color.new(color.red, 20) : color.new(color.gray, 40)
if barstate.islast
    table.cell(dashboard, 0, 0, "London 15m · 1:1",         text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 10), text_halign=text.align_center)
    table.cell(dashboard, 1, 0, "",                          text_color=color.white,  text_size=size.small, bgcolor=color.new(color.navy, 10))
    table.cell(dashboard, 0, 1, "Closed Trades",             text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 1, str.tostring(closedTrades),  text_color=color.white,  text_size=size.small)
    table.cell(dashboard, 0, 2, "Wins",                      text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 2, str.tostring(totalWins),     text_color=color.white,  text_size=size.small)
    table.cell(dashboard, 0, 3, "Win Rate",                  text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 3, winRateStr,                  text_color=color.white,  text_size=size.small, bgcolor=winColor)
    table.cell(dashboard, 0, 4, "Max Drawdown",              text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 4, ddStr,                       text_color=color.white,  text_size=size.small, bgcolor=ddColor)
    table.cell(dashboard, 0, 5, "Net R (after costs)",       text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 5, netRStr,                     text_color=color.white,  text_size=size.small, bgcolor=netRColor)
    table.cell(dashboard, 0, 6, "Today",                     text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 6, todayStatus,                 text_color=color.white,  text_size=size.small, bgcolor=todayColor)
    table.cell(dashboard, 0, 7, "Last trade grade",          text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 7, gradeStr,                    text_color=color.white,  text_size=size.small)
    table.cell(dashboard, 0, 8, "Size @ $" + str.tostring(riskUSD, "#") + " risk", text_color=color.silver, text_size=size.small)
    table.cell(dashboard, 1, 8, sizeStr,                     text_color=color.white,  text_size=size.small)

// ─── Visuals ──────────────────────────────────────────────────────────────────
plotshape(buySignal,  style=shape.triangleup,   location=location.belowbar, color=color.green, size=size.tiny)
plotshape(sellSignal, style=shape.triangledown, location=location.abovebar, color=color.red,   size=size.tiny)
bgcolor(inWin ? color.new(color.blue, 93) : na, title="London opening candle")
